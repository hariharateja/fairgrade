# --- Database: Supabase Postgres -------------------------------------------
# Supabase dashboard -> Connect (top bar) -> ORMs -> Prisma. Replace [YOUR-PASSWORD].
# Pooled connection, used by the app (port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection, used by migrations (port 5432):
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Photo storage: Supabase Storage -----------------------------------------
# Project Settings -> API (Data API URL) and API Keys -> Secret key (or legacy service_role).
# Server-side only: never expose the secret key in client code. Leave empty to store photos in ./uploads.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""

# --- Sessions ----------------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 32`.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- AI grading assistant ----------------------------------------------------
# Set ONE of these keys; with neither, the app runs in demo mode.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional: pick the provider explicitly when both keys are set ("claude" or "gemini").
# AI_PROVIDER="gemini"
# Optional: Gemini model. Any model name from Google AI Studio works.
# GEMINI_MODEL="gemini-3.5-flash"
